from PyQt5.QtWidgets import QApplication, QWidget, QVBoxLayout, QPushButton, QLabel, QStackedWidget
from PyQt5.QtCore import Qt

# CONSTANTES
ANCHO, ALTO = 1000, 800
TITULO = "Tardis"

class MenuPrincipal(QWidget):
    def __init__(self, stacked_widget):
        super().__init__()
        self.stacked = stacked_widget
        layout = QVBoxLayout()
        
        titulo = QLabel("Bienvenida")

        layout.setSpacing(15)
        
        btn_calendario = QPushButton("Abrir Calendario")
        btn_notas = QPushButton("Abrir Notas")
        btn_writing = QPushButton("Abrir Writing")
        
        # Darles un ancho y largo fijo para que todos midan lo mismo y se vea uniforme
        btn_calendario.setFixedWidth(200)
        btn_notas.setFixedWidth(200)
        btn_writing.setFixedWidth(200)
        btn_calendario.setFixedHeight(30)
        btn_notas.setFixedHeight(30)
        btn_writing.setFixedHeight(30)
        
        # Conectamos los botones a las funciones que cambian la pantalla
        btn_calendario.clicked.connect(self.ir_a_calendario)
        btn_notas.clicked.connect(self.ir_a_notas)
        btn_writing.clicked.connect(self.ir_a_writing)

        # PRIMER RESORTE: Empuja todo el contenido hacia abajo
        layout.addStretch()
        
        # Agregamos los widgets indicando que se centren horizontalmente
        layout.addWidget(titulo, alignment=Qt.AlignHCenter)
        layout.addWidget(btn_calendario, alignment=Qt.AlignHCenter)
        layout.addWidget(btn_notas, alignment=Qt.AlignHCenter)
        layout.addWidget(btn_writing, alignment=Qt.AlignHCenter)
        
        # SEGUNDO RESORTE: Empuja todo el contenido hacia arriba
        layout.addStretch()
        
        self.setLayout(layout)

    def ir_a_calendario(self):
        self.stacked.setCurrentIndex(1)

    def ir_a_notas(self):
        self.stacked.setCurrentIndex(2)

    def ir_a_writing(self):
        self.stacked.setCurrentIndex(3)

class PantallaBase(QWidget):
    def __init__(self, stacked_widget, texto_titulo):
        super().__init__()
        self.stacked = stacked_widget
        layout = QVBoxLayout()
        
        etiqueta = QLabel(texto_titulo)
        etiqueta.setAlignment(Qt.AlignCenter)
        
        btn_volver = QPushButton("Volver al Menú Principal")
        btn_volver.clicked.connect(self.volver_menu)
        
        layout.addWidget(etiqueta)
        layout.addWidget(btn_volver)
        self.setLayout(layout)

    def volver_menu(self):
        self.stacked.setCurrentIndex(0)

class MainWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.resize(ANCHO, ALTO)
        self.setWindowTitle(TITULO)
        
        self.stacked_widget = QStackedWidget()
        
        self.menu = MenuPrincipal(self.stacked_widget)
        self.calendario = PantallaBase(self.stacked_widget, "Interfaz Minimalista del Calendario")
        self.notas = PantallaBase(self.stacked_widget, "Espacio para Notas y Libretas")
        self.writing = PantallaBase(self.stacked_widget, "Carpetas, Capítulos y Fichas de Personajes")
        
        self.stacked_widget.addWidget(self.menu)
        self.stacked_widget.addWidget(self.calendario)
        self.stacked_widget.addWidget(self.notas)
        self.stacked_widget.addWidget(self.writing)
        
        main_layout = QVBoxLayout()
        main_layout.addWidget(self.stacked_widget)
        self.setLayout(main_layout)

def run():
    app = QApplication([])
    main_window = MainWindow()
    main_window.show() 
    app.exec_()

if __name__ == "__main__":
    run()

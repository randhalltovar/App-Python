from PyQt5.QtWidgets import QApplication, QWidget, QVBoxLayout, QTabWidget, QLabel
from PyQt5.QtCore import Qt

# CONSTANTES
ANCHO, ALTO = 900, 900
TITULO = "Tardis"

class CalendarioTab(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout()
        etiqueta = QLabel("Interfaz Calendario")
        layout.addWidget(etiqueta, alignment=Qt.AlignCenter)
        self.setLayout(layout)

class NotasTab(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout()
        etiqueta = QLabel("Interfaz Notas")
        layout.addWidget(etiqueta, alignment=Qt.AlignCenter)
        self.setLayout(layout)

class WritingTab(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout()
        etiqueta = QLabel("Interfaz Writing")
        layout.addWidget(etiqueta, alignment=Qt.AlignCenter)
        self.setLayout(layout)

class MainWindow(QWidget):
    def __init__(self, parent=None, flags=Qt.WindowFlags()):
        super().__init__(parent=parent, flags=flags)
        
        self.resize(ANCHO, ALTO)
        self.setWindowTitle(TITULO)
        
        # 1. Crear el gestor de pestañas
        self.tabs = QTabWidget()
        
        # 2. Instanciar las clases de cada sección
        self.tab_calendario = CalendarioTab()
        self.tab_notas = NotasTab()
        self.tab_writing = WritingTab()
        
        # 3. Agregar las instancias al gestor de pestañas
        self.tabs.addTab(self.tab_calendario, "Calendario")
        self.tabs.addTab(self.tab_notas, "Notas")
        self.tabs.addTab(self.tab_writing, "Writing")
        
        # 4. Crear un layout principal para la ventana y agregar las pestañas
        main_layout = QVBoxLayout()
        main_layout.addWidget(self.tabs)
        
        # 5. Aplicar el layout a la ventana principal
        self.setLayout(main_layout)

def run():
    app = QApplication([])
    main_window = MainWindow()
    main_window.show() 
    app.exec_()

if __name__ == "__main__":
    run()
   

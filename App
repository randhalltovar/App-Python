import json
import os
from PyQt5.QtWidgets import QWidget, QHBoxLayout, QVBoxLayout, QPushButton, QTextEdit, QApplication, QLabel, QColorDialog, QCalendarWidget, QStackedWidget, QTextEdit, QMenu, QAction, QFrame
from PyQt5.QtCore import Qt, QDate
from PyQt5.QtGui import QColor, QTextCharFormat, QBrush

# --- CONSTANTES GLOBALES ---
ANCHO, ALTO = 1000, 800
TITULO = "Tardis"

# --- ZONA DE MENÚ ---
class MenuPrincipal(QWidget):
    def __init__(self, stacked_widget):
        super().__init__()
        # Referencia al gestor de pantallas para poder decirle a donde ir luego
        self.stacked = stacked_widget
        
        # Diseño vertical principal para el menú
        layout = QVBoxLayout()
        # Espacio de 15 píxeles entre cada elemento para que no se vean amuñuñado
        layout.setSpacing(15)
        
        # Título de la partecita de arriba del menu
        titulo = QLabel("Bienvenida")
        
        # Creamos los botones de navegación
        btn_calendario = QPushButton("Abrir Calendario")
        btn_notas = QPushButton("Abrir Notas")
        btn_writing = QPushButton("Abrir Writing")
        
        # Darles un ancho y largo fijo para que todos midan lo mismo y se vea bonito
        btn_calendario.setFixedWidth(200)
        btn_notas.setFixedWidth(200)
        btn_writing.setFixedWidth(200)
        btn_calendario.setFixedHeight(30)
        btn_notas.setFixedHeight(30)
        btn_writing.setFixedHeight(30)
        
        # Conectamos el evento de clic de cada boton con su función de viaje correspondiente
        btn_calendario.clicked.connect(self.ir_a_calendario)
        btn_notas.clicked.connect(self.ir_a_notas)
        btn_writing.clicked.connect(self.ir_a_writing)
        
        # Empuja todo el contenido hacia abajo
        layout.addStretch()
        
        # Agregamos los elementos al diseño, asegurando que se centren de manera horizontal
        layout.addWidget(titulo, alignment=Qt.AlignHCenter)
        layout.addWidget(btn_calendario, alignment=Qt.AlignHCenter)
        layout.addWidget(btn_notas, alignment=Qt.AlignHCenter)
        layout.addWidget(btn_writing, alignment=Qt.AlignHCenter)
        
        # Empuja todo el contenido hacia arriba
        # Al tener un resorte arriba y otro abajo, los botones quedan atrapados en el centro 
        layout.addStretch()
        
        # Aplico diseño ensamblado a la ventana del menú
        self.setLayout(layout)

    # Funciones de navegacion, tipo cambian el índice del mazo de cartas para mostrar otra pantalla
    def ir_a_calendario(self):
        self.stacked.setCurrentIndex(1)
    def ir_a_notas(self):
        self.stacked.setCurrentIndex(2)
    def ir_a_writing(self):
        self.stacked.setCurrentIndex(3)

# --- ZONA DE TRABAJO 1: CALENDARIO ---
class CalendarioPantalla(QWidget):
    def __init__(self, stacked_widget):
        super().__init__()
        self.stacked = stacked_widget
        # Defino el archivo donde se guardarán los datos para persistencia
        self.archivo_datos = "recordatorios.json"
        # Cargo los datos existentes al iniciar la clase
        self.recordatorios = self.cargar_datos()
        self.color_seleccionado = QColor(212, 210, 210)
        self.tipo_repeticion = "Ninguna"
        
        layout = QVBoxLayout()
        
        self.calendario = QCalendarWidget()
        self.calendario.setGridVisible(True)
        
        # Conexiones originales
        self.calendario.currentPageChanged.connect(self.aplicar_formatos_visibles)
        self.calendario.clicked.connect(self.cargar_recordatorio)
        
        # --- ESTILO ACTUALIZADO --- # TENIA QUE CAMBIAR ESTO, PERO NO ENCONTRABA COMO, ASI QUE ESTE PEDAZO DE ESTILO ES DE GEMINI
        estilo = """
            QCalendarWidget { border: none; border-radius: 15px; background: white; }
            QCalendarWidget QWidget#qt_calendar_navigationbar { background-color: #b7c7c7; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom: none; padding: 20px; }
            QCalendarWidget QTableView { border: none; border-bottom-left-radius: 15px; border-bottom-right-radius: 15px; background: white; outline: 0px; }
            QCalendarWidget QToolButton { font-size: 18px; color: #073B4C; font-weight: bold; padding: 10px; border: none; }
            QCalendarWidget QAbstractButton#qt_calendar_prevmonth, QAbstractButton#qt_calendar_nextmonth { qproperty-icon: none; width: 0px; }
            QCalendarWidget QAbstractItemView:disabled { color: #7a7a7a; background-color: #d8ebed; }
        """ 
        self.calendario.setStyleSheet(estilo)
        
        self.panel_recordatorios = QFrame()
        self.panel_recordatorios.setFrameShape(QFrame.NoFrame)
        panel_layout = QVBoxLayout()
        
        header_layout = QHBoxLayout()
        self.lbl_fecha = QLabel("Selecciona una fecha")
        
        btn_opciones = QPushButton("...") 
        btn_opciones.setFixedWidth(50)
        btn_opciones.setMenu(self.crear_menu_opciones())
        
        header_layout.addWidget(self.lbl_fecha)
        header_layout.addWidget(btn_opciones)
        
        self.input_nota = QTextEdit()
        self.input_nota.setPlaceholderText("Escribe aquí tu recordatorio...")
        self.btn_guardar = QPushButton("Guardar Recordatorio")
        self.btn_guardar.clicked.connect(self.guardar_nota)
        
        # botón para eliminar, oculto por defecto
        self.btn_eliminar = QPushButton("Eliminar Recordatorio")
        self.btn_eliminar.setStyleSheet("background-color: #ff6b6b; color: white;")
        self.btn_eliminar.clicked.connect(self.eliminar_nota)
        self.btn_eliminar.hide()
        
        panel_layout.addLayout(header_layout)
        panel_layout.addWidget(self.input_nota)
        panel_layout.addWidget(self.btn_guardar)
        panel_layout.addWidget(self.btn_eliminar) # Agregado al layoutt
        self.panel_recordatorios.setLayout(panel_layout)
        
        btn_volver = QPushButton("Volver al Menú Principal")
        btn_volver.clicked.connect(self.volver_menu)
        
        layout.addWidget(self.calendario, stretch=3)
        layout.addWidget(self.panel_recordatorios, stretch=1)
        layout.addWidget(btn_volver, alignment=Qt.AlignCenter)
        
        self.setLayout(layout)
        self.aplicar_formatos_visibles()

    # Función para leer el archivo JSON y reconstruir el diccionario
    def cargar_datos(self):
        if os.path.exists(self.archivo_datos):
            with open(self.archivo_datos, 'r') as f:
                data = json.load(f)
                rec = {}
                for k, v in data.items():
                    key = tuple(eval(k)) # Convertimos la cadena de vuelta a tupla
                    v["color"] = QColor(v["color"]) # Recuperamos el objeto QColor
                    rec[key] = v
                return rec
        return {}

    # Función para convertir tipos complejos a strings y guardar en JSON
    def guardar_datos(self):
        data_to_save = {}
        for k, v in self.recordatorios.items():
            val_copy = v.copy()
            val_copy["color"] = v["color"].name() # Guardamos solo el código hex del color
            data_to_save[str(k)] = val_copy
        with open(self.archivo_datos, 'w') as f:
            json.dump(data_to_save, f)

    def crear_menu_opciones(self):
        menu = QMenu()
        a1 = menu.addAction("Repetición: Anual")
        a2 = menu.addAction("Repetición: Mensual")
        a1.triggered.connect(lambda: setattr(self, 'tipo_repeticion', "Anual"))
        a2.triggered.connect(lambda: setattr(self, 'tipo_repeticion', "Mensual"))
        menu.addSeparator()
        action_color = menu.addAction("Elegir color")
        action_color.triggered.connect(self.abrir_selector_color)
        return menu

    def abrir_selector_color(self):
        color = QColorDialog.getColor()
        if color.isValid(): self.color_seleccionado = color

    def guardar_nota(self):
        fecha = self.calendario.selectedDate()
        texto = self.input_nota.toPlainText()
        if texto:
            key = self.obtener_key_actual(fecha)
            self.recordatorios[key] = {"texto": texto, "color": self.color_seleccionado}
            self.guardar_datos() # Persistimos cada vez que guardamos
            self.aplicar_formatos_visibles()
            self.cargar_recordatorio(fecha)

    # Lógica nueva para borrar una entrada del diccionario y actualizar archivo
    def eliminar_nota(self):
        fecha = self.calendario.selectedDate()
        key = self.obtener_key_actual(fecha)
        if key in self.recordatorios:
            del self.recordatorios[key]
            self.guardar_datos() # Actualizamos el archivo tras borrar
            self.input_nota.clear()
            self.aplicar_formatos_visibles()
            self.btn_eliminar.hide()

    def obtener_key_actual(self, fecha):
        if self.tipo_repeticion == "Anual": return (fecha.day(), fecha.month(), None, "Anual")
        elif self.tipo_repeticion == "Mensual": return (fecha.day(), None, None, "Mensual")
        else: return (fecha.day(), fecha.month(), fecha.year(), "Ninguna")

    def aplicar_formatos_visibles(self):
        self.calendario.setDateTextFormat(QDate(), QTextCharFormat())
        year = self.calendario.yearShown()
        month = self.calendario.monthShown()
        
        formato_azul = QTextCharFormat()
        formato_azul.setForeground(QBrush(QColor("#073B4C")))
        
        primer_dia = QDate(year, month, 1)
        for i in range(primer_dia.daysInMonth()):
            fecha = primer_dia.addDays(i)
            if fecha.dayOfWeek() == 6 or fecha.dayOfWeek() == 7:
                self.calendario.setDateTextFormat(fecha, formato_azul)
                
        for (d, m, y, tipo), data in self.recordatorios.items():
            target_date = QDate()
            if tipo == "Anual" and m == month: target_date = QDate(year, m, d)
            elif tipo == "Mensual" and d <= primer_dia.daysInMonth(): target_date = QDate(year, month, d)
            elif tipo == "Ninguna" and m == month and y == year: target_date = QDate(year, m, d)
                
            if target_date.isValid():
                formato = QTextCharFormat()
                formato.setBackground(QBrush(data["color"]))
                self.calendario.setDateTextFormat(target_date, formato)

    def cargar_recordatorio(self, fecha):
        self.lbl_fecha.setText(f"Recordatorios: {fecha.toString('dd/MM/yyyy')}")
        keys = [(fecha.day(), fecha.month(), fecha.year(), "Ninguna"), 
                (fecha.day(), fecha.month(), None, "Anual"), 
                (fecha.day(), None, None, "Mensual")]
        
        found = False
        for k in keys:
            if k in self.recordatorios:
                self.input_nota.setPlainText(self.recordatorios[k]["texto"])
                self.btn_eliminar.show() # Mostramos botón si hay nota
                found = True
                break
        if not found: 
            self.input_nota.clear()
            self.btn_eliminar.hide() # Ocultamos si no hay nada

    def volver_menu(self):
        self.stacked.setCurrentIndex(0)


    # --- FUNCIONES DE LÓGICA DE NOTAS ---
    def cargar_datos(self):
        if os.path.exists(self.archivo_datos):
            with open(self.archivo_datos, 'r', encoding='utf-8') as f:
                return json.load(f)
        return {}

    def actualizar_lista_ui(self):
        self.lista_notas.clear()
        texto_filtro = self.barra_busqueda.text().lower()
        
        for nota_id, datos in self.notes.items() if hasattr(self, 'notes') else self.notas.items():
            titulo_mostrar = datos.get("titulo", "Sin título")
            if not titulo_mostrar.strip(): titulo_mostrar = "Sin título"
            
            item = QListWidgetItem(f"{titulo_mostrar}\n{datos.get('fecha_edicion', '')}")
            item.setData(Qt.UserRole, nota_id) 
            self.lista_notas.addItem(item)
            
            # Si hay una búsqueda activa al actualizar, respetamos el filtro ocultándolo directamente
            if texto_filtro and texto_filtro not in titulo_mostrar.lower():
                item.setHidden(True)

    # Función encargada de filtrar visualmente los elementos en base a la barra de búsqueda
    def filtrar_notas(self, texto_busqueda):
        texto_busqueda = texto_busqueda.lower()
        for i in range(self.lista_notas.count()):
            item = self.lista_notas.item(i)
            nota_id = item.data(Qt.UserRole)
            datos = self.notas.get(nota_id, {})
            titulo = datos.get("titulo", "").lower()
            
            # Si el término de búsqueda está en el título, se muestra; si no, se oculta
            item.setHidden(texto_busqueda not in titulo)

    def crear_nueva_nota(self):
        nuevo_id = str(uuid.uuid4())
        fecha_actual = QDateTime.currentDateTime().toString("dd/MM/yyyy HH:mm")
        
        self.notas[nuevo_id] = {
            "titulo": "",
            "cuerpo": "",
            "fecha_edicion": fecha_actual
        }
        
        self.nota_actual_id = nuevo_id
        self.input_titulo.blockSignals(True)
        self.input_cuerpo.blockSignals(True)
        self.input_titulo.setText("")
        self.input_cuerpo.setPlainText("")
        self.input_titulo.blockSignals(False)
        self.input_cuerpo.blockSignals(False)
        
        self.btn_eliminar_nota.show()
        self.actualizar_lista_ui()
        self.ejecutar_guardado() 

    def cargar_nota_seleccionada(self, item):
        nota_id = item.data(Qt.UserRole)
        self.nota_actual_id = nota_id
        datos = self.notas.get(nota_id, {})
        
        self.input_titulo.blockSignals(True)
        self.input_cuerpo.blockSignals(True)
        
        self.input_titulo.setText(datos.get("titulo", ""))
        self.input_cuerpo.setHtml(datos.get("cuerpo", ""))
        
        self.input_titulo.blockSignals(False)
        self.input_cuerpo.blockSignals(False)
        
        self.btn_eliminar_nota.show()
        self.indicador_estado.setStyleSheet("background-color: #2ecc71; border-radius: 5px;")

    def eliminar_nota_actual(self):
        if self.nota_actual_id and self.nota_actual_id in self.notas:
            del self.notas[self.nota_actual_id]
            self.nota_actual_id = None
            
            self.input_titulo.blockSignals(True)
            self.input_cuerpo.blockSignals(True)
            self.input_titulo.clear()
            self.input_cuerpo.clear()
            self.input_titulo.blockSignals(False)
            self.input_cuerpo.blockSignals(False)
            
            with open(self.archivo_datos, 'w', encoding='utf-8') as f:
                json.dump(self.notas, f, ensure_ascii=False, indent=4)
            
            self.btn_eliminar_nota.hide()
            self.indicador_estado.setStyleSheet("background-color: #d1d1d1; border-radius: 5px;")
            self.actualizar_lista_ui()

    # --- AUTOGUARDADO ---

    def iniciar_debounce(self):
        if not self.nota_actual_id:
            return
        self.indicador_estado.setStyleSheet("background-color: #f39c12; border-radius: 5px;")
        self.timer_autoguardado.start()

    def ejecutar_guardado(self):
        if not self.nota_actual_id:
            return
            
        titulo = self.input_titulo.text()
        cuerpo = self.input_cuerpo.toHtml() 
        fecha = QDateTime.currentDateTime().toString("dd/MM/yyyy HH:mm")
        
        self.notas[self.nota_actual_id] = {
            "titulo": titulo,
            "cuerpo": cuerpo,
            "fecha_edicion": fecha
        }
        
        with open(self.archivo_datos, 'w', encoding='utf-8') as f:
            json.dump(self.notas, f, ensure_ascii=False, indent=4)
            
        self.indicador_estado.setStyleSheet("background-color: #2ecc71; border-radius: 5px;")
        self.actualizar_lista_ui()

    def verificar_seleccion_texto(self):
        if self.input_cuerpo.textCursor().hasSelection():
            self.toolbar.show()
        else:
            self.toolbar.hide()

    def volver_menu(self):
        self.stacked.setCurrentIndex(0)



# --- CLASE PERSONALIZADA PARA EL EDITOR DE TEXTO (DRAG & DROP E IMÁGENES) ---
class EditorMinimalista(QTextEdit):
    def __init__(self, ventana_notas=None):
        super().__init__()
        self.ventana_notas = ventana_notas
        self.setAcceptDrops(True)
        self.setStyleSheet("""
            QTextEdit {
                border: none;
                font-family: 'Segoe UI', 'Inter', 'Roboto', sans-serif;
                font-size: 16px;
                line-height: 1.6;
                color: #31295f;
                background-color: transparent;
                selection-background-color: #E9445F;
                selection-color: #F9F5F0;
            }
        """)
        self.setContextMenuPolicy(Qt.CustomContextMenu)
        self.customContextMenuRequested.connect(self.mostrar_menu_contextual)

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()
        else:
            super().dragEnterEvent(event)

    def dropEvent(self, event):
        if event.mimeData().hasUrls():
            for url in event.mimeData().urls():
                if url.isLocalFile():
                    ruta_imagen = url.toLocalFile()
                    if ruta_imagen.lower().endswith(('.png', '.jpg', '.jpeg', '.gif')):
                        self.insertar_imagen(ruta_imagen)
            event.acceptProposedAction()
        else:
            super().dropEvent(event)

    def insertar_imagen(self, ruta):
        cursor = self.textCursor()
        formato_imagen = QTextImageFormat()
        formato_imagen.setName(ruta)
        formato_imagen.setWidth(300) 
        cursor.insertImage(formato_imagen)
        
        if self.ventana_notas:
            self.ventana_notas.iniciar_debounce()

    def mostrar_menu_contextual(self, pos):
        cursor = self.cursorForPosition(pos)
        formato = cursor.charFormat()
        menu = self.createStandardContextMenu(pos)
        
        if formato.isImageFormat():
            menu.addSeparator()
            accion_agrandar = menu.addAction("🔍 Agrandar Imagen (+50px)")
            accion_achicar = menu.addAction("🔍 Achicar Imagen (-50px)")
            
            accion_elegida = menu.exec_(self.mapToGlobal(pos))
            
            if accion_elegida:
                img_format = formato.toImageFormat()
                ancho_actual = img_format.width() if img_format.width() > 0 else 300
                
                if accion_elegida == accion_agrandar:
                    img_format.setWidth(ancho_actual + 50)
                elif accion_elegida == accion_achicar:
                    img_format.setWidth(max(50, ancho_actual - 50)) 
                
                cursor.movePosition(QTextCursor.Right, QTextCursor.KeepAnchor)
                cursor.setCharFormat(img_format)
                
                if self.ventana_notas:
                    self.ventana_notas.iniciar_debounce()
        else:
            menu.exec_(self.mapToGlobal(pos))


class MainWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.resize(ANCHO, ALTO)
        self.setWindowTitle(TITULO)
        
        self.stacked_widget = QStackedWidget()
        
        self.menu = MenuPrincipal(self.stacked_widget)
        self.calendario = CalendarioPantalla(self.stacked_widget)
        self.notas = NotasPantalla(self.stacked_widget)
        self.writing = WritingPantalla(self.stacked_widget)
        
        self.stacked_widget.addWidget(self.menu)         
        self.stacked_widget.addWidget(self.calendario)   
        self.stacked_widget.addWidget(self.notas)        
        self.stacked_widget.addWidget(self.writing)      
        
        main_layout = QVBoxLayout()
        main_layout.addWidget(self.stacked_widget)
        self.setLayout(main_layout)

# --- ZONA DE EJECUCIÓN ---
def run():
    app = QApplication([])
    main_window = MainWindow()
    main_window.show() 
    app.exec_()

if __name__ == "__main__":
    run()

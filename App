# --- ZONA DE ENSAMBLAJE PRINCIPAL ---
class MainWindow(QWidget):
    def __init__(self):
        super().__init__()
        # Configuramos el tamaño y el título usando las constantes globales definidas arriba
        self.resize(ANCHO, ALTO)
        self.setWindowTitle(TITULO)
        
        # Creamos el gestor de pantallas, que funciona como un mazo de cartas (lo de arriba, que le puse que si 1, 2)
        self.stacked_widget = QStackedWidget()
        
        # Instanciamos cada una de las pantallas pasandoles el gestor para que puedan comunicarse
        self.menu = MenuPrincipal(self.stacked_widget)
        self.calendario = CalendarioPantalla(self.stacked_widget)
        self.notas = NotasPantalla(self.stacked_widget)
        self.writing = WritingPantalla(self.stacked_widget)
        
        # Agregamos las pantallas al gestor en orden
        # El orden en que se agregan define su número de índice interno (0, 1, 2, 3)
        self.stacked_widget.addWidget(self.menu)         # Índice 0
        self.stacked_widget.addWidget(self.calendario)   # Índice 1
        self.stacked_widget.addWidget(self.notas)        # Índice 2
        self.stacked_widget.addWidget(self.writing)      # Índice 3
        
        # Creamos un diseño para la ventana principal y empaquetamos el gestor de pantallas dentro
        main_layout = QVBoxLayout()
        main_layout.addWidget(self.stacked_widget)
        self.setLayout(main_layout)

# --- ZONA DE EJECUCIÓN ---
# función motor que arranca todo el sistema visual
def run():
    app = QApplication([])
    main_window = MainWindow()
    main_window.show() 
    app.exec_()

# Esta condición de seguridad asegura que el código solo se ejecute si corremos este archivo directamente
if __name__ == "__main__":
    run()

    def cargar_datos(self):
        if os.path.exists(self.archivo_datos):
            with open(self.archivo_datos, 'r', encoding='utf-8') as f:
                return json.load(f)
        return {}

    def actualizar_lista_ui(self):
        self.lista_notas.clear()
        texto_filtro = self.barra_busqueda.text().lower()
        
        # La correccion de la referencia 'self.notes' que causaba errores
        for nota_id, datos in self.notas.items():
            titulo_mostrar = datos.get("titulo", "").strip() or "Sin título"
            item = QListWidgetItem(f"{titulo_mostrar}\n{datos.get('fecha_edicion', '')}")
            item.setData(Qt.UserRole, nota_id) 
            self.lista_notas.addItem(item)
            
            if texto_filtro and texto_filtro not in titulo_mostrar.lower():
                item.setHidden(True)

    def filtrar_notas(self, texto_busqueda):
        texto_busqueda = texto_busqueda.lower()
        for i in range(self.lista_notas.count()):
            item = self.lista_notas.item(i)
            datos = self.notas.get(item.data(Qt.UserRole), {})
            item.setHidden(texto_busqueda not in datos.get("titulo", "").lower())

    def crear_nueva_nota(self):
        nuevo_id = str(uuid.uuid4())
        self.notas[nuevo_id] = {"titulo": "", "cuerpo": "", "fecha_edicion": QDateTime.currentDateTime().toString("dd/MM/yyyy HH:mm")}
        self.nota_actual_id = nuevo_id
        
        self.input_titulo.blockSignals(True)
        self.input_cuerpo.blockSignals(True)
        self.input_titulo.clear()
        self.input_cuerpo.clear()
        self.input_titulo.blockSignals(False)
        self.input_cuerpo.blockSignals(False)
        
        self.btn_eliminar_nota.show()
        self.actualizar_lista_ui()
        self.ejecutar_guardado() 

    def cargar_nota_seleccionada(self, item):
        self.nota_actual_id = item.data(Qt.UserRole)
        datos = self.notas.get(self.nota_actual_id, {})
        
        self.input_titulo.blockSignals(True)
        self.input_cuerpo.blockSignals(True)
        self.input_titulo.setText(datos.get("titulo", ""))
        self.input_cuerpo.setHtml(datos.get("cuerpo", ""))
        self.input_titulo.blockSignals(False)
        self.input_cuerpo.blockSignals(False)
        
        self.btn_eliminar_nota.show()
        self.indicador_estado.setStyleSheet("background-color: #690571; border-radius: 6px;")

    def eliminar_nota_actual(self):
        if self.nota_actual_id in self.notas:
            del self.notas[self.nota_actual_id]
            self.nota_actual_id = None
            self.input_titulo.clear()
            self.input_cuerpo.clear()
            
            with open(self.archivo_datos, 'w', encoding='utf-8') as f:
                json.dump(self.notas, f, ensure_ascii=False, indent=4)
            
            self.btn_eliminar_nota.hide()
            self.actualizar_lista_ui()

    def iniciar_debounce(self):
        if self.nota_actual_id:
            self.indicador_estado.setStyleSheet("background-color: #E9445F; border-radius: 6px;")
            self.timer_autoguardado.start()

    def ejecutar_guardado(self):
        if not self.nota_actual_id: return
            
        self.notas[self.nota_actual_id] = {
            "titulo": self.input_titulo.text(),
            "cuerpo": self.input_cuerpo.toHtml(),
            "fecha_edicion": QDateTime.currentDateTime().toString("dd/MM/yyyy HH:mm")
        }
        
        with open(self.archivo_datos, 'w', encoding='utf-8') as f:
            json.dump(self.notas, f, ensure_ascii=False, indent=4)
            
        self.indicador_estado.setStyleSheet("background-color: #690571; border-radius: 6px;")
        self.actualizar_lista_ui()

